# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://127.0.0.1:5173

# Kie.ai (legacy variable names are used by most provider routes)
SEEDREAM_API_KEY=your_kie_api_key
SEEDREAM_API_BASE_URL=https://api.kie.ai
# Optional Seedance-specific overrides
KIE_API_KEY=
KIE_API_BASE_URL=
# Set both values to route Seedance through OpenRouter instead of Kie.
SEEDANCE_PROVIDER=kie
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai

# Clerk
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret

# Supabase server access and media relay signing
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PROVIDER_MEDIA_SIGNING_SECRET=use-a-dedicated-random-secret
# Optional publicly reachable HTTPS relay overrides; leave blank for defaults
PROVIDER_MEDIA_BASE_URL=
PROVIDER_INPUT_RELAY_BASE_URL=
PROVIDER_MEDIA_URL_TTL_SECONDS=900

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID=your_stripe_price_id

# Optional storage tuning
SUPABASE_STORAGE_UPLOAD_TIMEOUT_MS=20000
